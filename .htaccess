RewriteEngine On

# Custom 404 page for invalid / missing URLs
ErrorDocument 404 /404.html

# Remove .html from URL
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)$ $1.html [L]

# Optional: Redirect .html URLs to extensionless (SEO-friendly redirect)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/([^/]+)\.html\sHTTP/
RewriteRule ^([^/]+)\.html$ /$1 [R=301,L]


# Redirect /index or /index.html to root /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/index(.html)?\sHTTP/
RewriteRule ^index(.html)?$ / [R=301,L]

# Local Laragon / Apache mod_php
<IfModule php_module>
  AddHandler application/x-httpd-php .php
</IfModule>
# cPanel EasyApache / LiteSpeed (production) — ignored when module is absent
<IfModule lite_speed>
  AddHandler application/x-httpd-ea-php82___lsphp .php .php8 .phtml
</IfModule>
